# ---------------------------------------------------------------------------
# Lawgin — environment configuration
# Copy this file to `.env` and provide your own key. NEVER commit a real key.
# Get a free key at https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------

# Required: Google Gemini API key (kept in .env / Vercel project settings only).
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Optional: primary model. The app automatically falls back across a verified
# free-tier ladder if this model is rate-limited or unavailable.
# Verified free & structured-JSON capable: gemini-3.7-flash (recommended).
VITE_GEMINI_MODEL=gemini-3.7-flash
